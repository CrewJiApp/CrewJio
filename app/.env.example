# Copy to app/.env.local and fill in. .env.local is gitignored.
# Everything here ends up inside the app, so it is PUBLIC. Never put a secret key here
# (no service role key, no Claude key). Those live only in Supabase Edge Function secrets.

# Supabase: Project Settings > API (or Data API). Use the Project URL and the anon / publishable key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
