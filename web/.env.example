# Copy to .env.local and fill in. .env.local is gitignored. Never commit real keys.
# Only NEXT_PUBLIC_ variables reach the browser. Everything else stays on the server.

# Public site URL (used in emails and the share button). Use http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=https://crewjio.com

# Supabase: Project Settings > API. The service role key bypasses RLS: server only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend: API Keys > Create (sending access, domain mail.crewjio.com).
RESEND_API_KEY=re_your_api_key

# Any long random string. Signs unsubscribe links. Generate with: openssl rand -base64 32
UNSUBSCRIBE_SECRET=replace-with-a-long-random-string
