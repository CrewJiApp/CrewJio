# Edge Function secrets for roster-import. Set them with:
#   npx supabase secrets set --env-file supabase/functions/roster-import/.env
# Copy this file to .env (gitignored) and fill it in. Never commit real values.

# Anthropic Console -> API keys -> Create key. Starts with sk-ant-
ANTHROPIC_API_KEY=sk-ant-replace-me

# Optional. Imports each person can run per month (default 8).
# If you change it, also change IMPORTS_PER_MONTH in app/src/lib/roster-import.ts.
ROSTER_IMPORT_MONTHLY_LIMIT=8

# Optional. Cost guards. Tries per person per 24 hours (failed reads count too, default 6), and
# tries across everybody per 24 hours (default 120). When everybody's allowance is used up, the app
# says roster reading is busy until the next day. Raise these only if real users hit them.
# ROSTER_IMPORT_DAILY_LIMIT=6
# ROSTER_IMPORT_DAILY_LIMIT_ALL=120

# Optional. Which Claude model reads the screenshots (default claude-sonnet-5-5).
# ROSTER_IMPORT_MODEL=claude-sonnet-5-5
