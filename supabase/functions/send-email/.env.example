# Edge Function secrets for send-email. Set them with:
#   npx supabase secrets set --env-file supabase/functions/send-email/.env
# Copy this file to .env (gitignored) and fill it in. Never commit real values.

# Shown when you enable Authentication -> Hooks -> Send Email. Looks like v1,whsec_...
SEND_EMAIL_HOOK_SECRET=v1,whsec_replace-me

# Resend: API Keys -> Create (sending access).
RESEND_API_KEY=re_your_api_key

# Optional. Defaults to CrewJio <hello@mail.crewjio.com>. Switch to CrewJio <hello@crewjio.com>
# once crewjio.com is verified in Resend.
EMAIL_FROM=CrewJio <hello@mail.crewjio.com>
