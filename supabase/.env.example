# Secrets for Supabase Edge Functions. Copy to supabase/.env.local for local runs (gitignored),
# and set them in production with: npx supabase secrets set --env-file supabase/.env.local
# These never go in app/ or web/ client code.

# Claude API key for the roster import function (build step 5). Anthropic Console > API Keys.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Flight status provider for live flights (build step 7). Not chosen yet.
FLIGHT_DATA_API_KEY=your-flight-data-key
